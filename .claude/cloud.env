# UniSwap: environment variables for Claude Code cloud sessions (claude.ai/code, Claude app).
# Paste this into the cloud environment's settings, in the "Environment variables" box.
# Nothing here is secret: the cloud runs its own throwaway PostgreSQL inside its machine.
# Email, Stripe, Cloudinary, Telegram and Bakong are left out on purpose, so they stay off.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/uniswap
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/uniswap_test
JWT_SECRET=cloud-sessions-only-any-long-random-string
FRONTEND_ORIGIN=http://localhost:3000
PORT=4000
API_URL=http://localhost:4000
