# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000

# Local PostgreSQL, or a Supabase connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uniswap

# Only for `npm run test:api`: a SEPARATE database that the API tests wipe on every run.
# Create it once with: createdb uniswap_test   (Docker: docker exec <container> createdb -U <user> uniswap_test)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/uniswap_test

# Any long random string, e.g. the output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Where the Next.js frontend runs, so the browser is allowed to call this API
FRONTEND_ORIGIN=http://localhost:3000

# Optional: the email account that sends verification and password-reset links. While SMTP_PASS is
# empty, no email is sent and both links are printed in the server log instead. Test with: npm run email:test
#   School Outlook / Microsoft 365: SMTP_HOST=smtp.office365.com  SMTP_PORT=587  (your normal password)
#   Gmail:                          SMTP_HOST=smtp.gmail.com      SMTP_PORT=465  (a Google App Password)
# Wrap the password in single quotes if it contains spaces or a # character.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=you@university.edu.kh
SMTP_PASS=
# Optional sender name and address; defaults to "UniSwap <SMTP_USER>".
# EMAIL_FROM=UniSwap <you@university.edu.kh>

# ---- Optional services: each stays switched off until its keys are filled in ----

# Cloudinary photo hosting (cloudinary.com -> Dashboard -> API Keys). Without it, photos are saved
# in backend/uploads/, which is fine locally but is wiped whenever Render restarts the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe card payments, TEST MODE ONLY (dashboard.stripe.com -> Developers -> API keys).
# Live keys (sk_live_...) are refused. Test card: 4242 4242 4242 4242, any future date, any CVC.
STRIPE_SECRET_KEY=
# Optional locally; needed when deployed (Developers -> Webhooks -> endpoint .../api/payments/webhook,
# event checkout.session.completed). Covers buyers who close the tab before returning to UniSwap.
STRIPE_WEBHOOK_SECRET=

# KHQR payments through Bakong (REAL money, paid straight to each seller's own Bakong account).
# Get a developer token at https://api-bakong.nbc.gov.kh (register, verify your email, then copy the
# token). It expires after 90 days; renew it there. Bakong only answers Cambodian IP addresses.
BAKONG_TOKEN=

# Telegram notifications (talk to @BotFather -> /newbot). The username is without the @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# The "Ask UniSwap" shopping assistant uses Groq when GROQ_API_KEY is set, otherwise Gemini when
# GEMINI_API_KEY is set, otherwise it is switched off. Both have free keys that need no card. The
# assistant only sends the student's question and listing details (never names or emails).

# Groq, the main one. Sign up at https://console.groq.com, then create a key under "API Keys".
# The model defaults to openai/gpt-oss-120b. Free limits (https://console.groq.com/docs/rate-limits):
# 30 requests a minute and 1,000 a day, 8,000 tokens a minute and 200,000 a day.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Gemini, the backup. Free key: https://aistudio.google.com/apikey
# On the free tier Google may read what is sent to improve its products. Free limits are per Google project:
# see https://aistudio.google.com/rate-limit. The model defaults to gemini-3.5-flash-lite (15 requests a minute;
# gemini-3.6-flash allows only 20 a day).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Use one of them by name even when both keys are set, e.g. gemini on a day Groq has trouble.
# Restart the API after changing any of these.
# ASSISTANT_PROVIDER=gemini
