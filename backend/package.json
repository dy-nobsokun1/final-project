{
  "name": "uniswap-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UniSwap REST API (Node.js + Express + PostgreSQL)",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "start:prod": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "db:setup": "node --env-file=.env scripts/db-setup.js",
    "db:seed": "node --env-file=.env scripts/db-seed.js",
    "db:samples": "node --env-file=.env scripts/db-samples.js",
    "db:demo-deals": "node --env-file=.env scripts/db-demo-deals.js",
    "email:test": "node --env-file=.env scripts/check-email.js",
    "test": "node --test test/*.test.js",
    "test:api": "node --env-file=.env test/api/reset-db.js && node --env-file=.env --test test/api/*.test.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.12",
    "pg": "^8.16.3"
  }
}
